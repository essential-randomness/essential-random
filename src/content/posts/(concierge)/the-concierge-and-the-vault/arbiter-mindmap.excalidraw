        }
      ],
      "updated": 1780817733100,
      "link": null,
      "locked": false,
      "text": "Uses Rego language to define\npolicies: \n- https://snyk.io/blog/introduction-to-rego/\n- https://www.openpolicyagent.org/docs/policy-language \n\nCan also:\n- Ask external services for informations to determine access\n\n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Uses Rego language to define\npolicies: \n- https://snyk.io/blog/introduction-to-rego/\n- https://www.openpolicyagent.org/docs/policy-language \n\nCan also:\n- Ask external services for informations to determine access\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },

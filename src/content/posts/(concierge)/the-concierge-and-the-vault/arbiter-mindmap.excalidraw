      "seed": 709601023,
      "version": 419,
      "versionNonce": 851645749,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780817781610,
      "link": null,
      "locked": false,
      "text": "- Permissions tell you who can do what...\n- ...but they don't tell you what the \"shape\" of the community is",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- Permissions tell you who can do what...\n- ...but they don't tell you what the \"shape\" of the community is",
      "autoResize": true,
      "lineHeight": 1.25
    },

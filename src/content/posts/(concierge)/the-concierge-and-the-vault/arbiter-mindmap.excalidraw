    },
    {
      "id": "V4LEmbi6yPJUZotFOTuFl",
      "type": "text",
      "x": -4177.661447002743,
      "y": -7395.266852280371,
      "width": 471.1967468261719,
      "height": 202.52485795454564,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "YHKu1Wz41uYF5_jNDle7W"
      ],
      "frameId": null,
      "index": "bFKZ",
      "roundness": null,
      "seed": 1585079697,
      "version": 725,
      "versionNonce": 1349905909,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "asJDeGvm-2izG7SapDG5a",
          "type": "arrow"
        }
      ],
      "updated": 1780817781610,
      "link": null,
      "locked": false,
      "text": "Each space can configure:\n- Whether members are public by default\n- Whether records are public by default\n\n- Members are added or removed from spaces\n- Members can read who is in the space without\nbeing able to read everything else in the space\n",
      "fontSize": 20.252485795454565,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each space can configure:\n- Whether members are public by default\n- Whether records are public by default\n\n- Members are added or removed from spaces\n- Members can read who is in the space without\nbeing able to read everything else in the space\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rxFh_ILsVgkwsSAU7bwom",
      "type": "text",
      "x": -4643.796637803931,
      "y": -7281.306586241599,
      "width": 303.519775390625,
      "height": 100,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "YHKu1Wz41uYF5_jNDle7W"
      ],
      "frameId": null,
      "index": "bFKd",
      "roundness": null,
      "seed": 208526879,
      "version": 409,
      "versionNonce": 1955640501,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "asJDeGvm-2izG7SapDG5a",
          "type": "arrow"
        },
        {
          "id": "w3wNcee2kq1V9U4A7ehJQ",
          "type": "arrow"
        }
      ],
      "updated": 1780817781610,
      "link": null,
      "locked": false,
      "text": "Members of a space write to \ntheir PDSes so you can't really\nstop them from writing data\nto a space",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Members of a space write to \ntheir PDSes so you can't really\nstop them from writing data\nto a space",
      "autoResize": true,
      "lineHeight": 1.25
    },

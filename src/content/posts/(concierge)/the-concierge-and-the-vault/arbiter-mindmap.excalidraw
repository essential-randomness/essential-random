      "boundElements": [],
      "updated": 1780817781610,
      "link": null,
      "locked": false,
      "text": "The \"Space Host\"\nknows who is in the\nspace and can \ngo fetch the records\n\n- In permissioned\nspaces a space does\nnot store records,\nthey are in individual\nmembers' PDSes",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "oCYNIkIYfUfNqrAUQRSG1",
      "originalText": "The \"Space Host\"\nknows who is in the\nspace and can \ngo fetch the records\n\n- In permissioned spaces a space does not store records,\nthey are in individual\nmembers' PDSes",
      "autoResize": true,
      "lineHeight": 1.25
    },

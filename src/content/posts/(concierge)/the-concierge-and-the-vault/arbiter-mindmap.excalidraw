        }
      ],
      "updated": 1780817733100,
      "link": null,
      "locked": false,
      "text": "To start:\n- Whoever created the admin/group\n  has full permissions\n\n=> but then they want to give rights\n    to more people\n\n...the \"arbiter lexicon draft\" was the\nattempt to define how that would \nhappen",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "To start:\n- Whoever created the admin/group\n  has full permissions\n\n=> but then they want to give rights\n    to more people\n\n...the \"arbiter lexicon draft\" was the\nattempt to define how that would \nhappen",
      "autoResize": true,
      "lineHeight": 1.25
    },

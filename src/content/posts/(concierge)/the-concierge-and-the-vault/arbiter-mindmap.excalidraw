      "isDeleted": false,
      "boundElements": [],
      "updated": 1780817733100,
      "link": null,
      "locked": false,
      "text": "1. use Rego language to define policy of \"setSpaceMemberAccess\"\n2. when request comes, that policy runs and checks for permission\n3. Mary gets added to the Role \n      => this is (currently) stored in the \"space host\"/arbiter",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. use Rego language to define policy of \"setSpaceMemberAccess\"\n2. when request comes, that policy runs and checks for permission\n3. Mary gets added to the Role \n      => this is (currently) stored in the \"space host\"/arbiter",
      "autoResize": true,
      "lineHeight": 1.25
    },

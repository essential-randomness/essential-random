      "version": 680,
      "versionNonce": 548211701,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780817781610,
      "link": null,
      "locked": false,
      "text": "\"Admin Group\"\n(also a space)\n- admins automatically\nhave access to\nevery space in that\ncommunity\n- Created by default, \ncannot be removed\n- Can have permissions of its\nown, but it doesn't necessarily\nhave all of them",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "PgBRMHf-Ve-pi6r_rUKVl",
      "originalText": "\"Admin Group\"\n(also a space)\n- admins automatically\nhave access to\nevery space in that\ncommunity\n- Created by default, \ncannot be removed\n- Can have permissions of its\nown, but it doesn't necessarily\nhave all of them",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "C1Dtw73J77cacSNQZ7chG",
      "type": "text",

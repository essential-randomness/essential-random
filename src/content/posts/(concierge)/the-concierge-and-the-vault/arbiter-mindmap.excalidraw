      "versionNonce": 1545097909,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780817781610,
      "link": null,
      "locked": false,
      "text": "\"Permission Groups\"\n=\nWho can administer permissions\n!= (IS NOT)\nwho can do app-specific stuff",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"Permission Groups\"\n=\nWho can administer permissions\n!= (IS NOT)\nwho can do app-specific stuff",

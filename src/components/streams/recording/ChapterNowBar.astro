---
import type { CollectionEntry } from "astro:content";
import ExternalLinkIcon from "./ExternalLinkIcon.astro";
import { formatTimestamp } from "./timestamp.ts";

type Recording = CollectionEntry<"streamRecordings">["data"];

interface Props {
  chapters: Recording["chapters"];
  sourceUrl: Recording["sourceUrl"];
}

const { chapters, sourceUrl } = Astro.props;
---

<recording-chapter-now class="chapter-now">
  {
    chapters.map((chapter, index) => {
      const steps = [
        { step: -1, arrow: "←", label: "Previous", target: chapters[index - 1] },
        { step: 1, arrow: "→", label: "Next", target: chapters[index + 1] },
      ];
      return (
        <div
          class="chapter-now-slide"
          data-chapter-index={index}
          hidden={index !== 0}
        >
          <p class="chapter-now-item chapter-now-current">
            <span class="chapter-now-heading">
              <span class="chapter-now-label">
                Now · {index + 1} of {chapters.length}
              </span>
              <a
                class="source-link"
                href={sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Open on Streamplace (new tab)"
                title="Open on Streamplace"
              >
                <ExternalLinkIcon />
              </a>
            </span>
            <span class="chapter-now-title">{chapter.title}</span>
          </p>
          {steps.map(({ step, arrow, label, target }) => (
            <button
              class="chapter-now-item chapter-now-step"
              type="button"
              data-step={step}
              data-seek-time={target?.start}
              disabled={!target}
            >
              <span class="chapter-now-label">
                <span class="chapter-now-arrow" aria-hidden="true">
                  {arrow}
                </span>{" "}
                {label}
                {target && (
                  <>
                    {" · "}
                    <span class="chapter-time">
                      {formatTimestamp(target.start)}
                    </span>
                  </>
                )}
              </span>
              <span class="chapter-now-title">{target?.title ?? "N/A"}</span>
            </button>
          ))}
        </div>
      );
    })
  }
</recording-chapter-now>

<script>
  import { ChapterEvent, RecordingElement, SeekEvent } from "./events.ts";

  class RecordingChapterNow extends RecordingElement {
    connect(signal: AbortSignal) {
      const slides = Array.from(
        this.querySelectorAll<HTMLElement>(".chapter-now-slide"),
      );

      this.listen({
        event: ChapterEvent,
        handler: ({ index }) => {
          const focusedStep =
            this.querySelector<HTMLElement>("[data-step]:focus")?.dataset.step;
          slides.forEach((slide, slideIndex) => {
            slide.hidden = slideIndex !== index;
          });
          if (focusedStep !== undefined) {
            const current = slides[index];
            (
              current?.querySelector<HTMLButtonElement>(
                `[data-step="${focusedStep}"]:enabled`,
              ) ??
              current?.querySelector<HTMLButtonElement>("[data-step]:enabled")
            )?.focus();
          }
        },
      });

      this.addEventListener(
        "click",
        (event) => {
          const step =
            event.target instanceof Element
              ? event.target.closest<HTMLElement>("[data-seek-time]")
              : null;
          if (step) {
            this.send(new SeekEvent(Number(step.dataset.seekTime)));
          }
        },
        { signal },
      );
    }
  }

  customElements.define("recording-chapter-now", RecordingChapterNow);
</script>

<style>
  .chapter-now {
    display: block;
    border-bottom: 1px solid #ddd;
  }

  .chapter-now-slide {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      "now previous"
      "now next";
    gap: 1px;
    background: #ddd;
  }

  .chapter-now-slide[hidden] {
    display: none;
  }

  @container player-card (max-width: 34rem) {
    .chapter-now-slide {
      grid-template-areas:
        "now now"
        "previous next";
    }
  }

  :global(stream-recording.is-floating) .chapter-now-slide {
    grid-template-areas: "now";
    grid-template-columns: minmax(0, 1fr);
  }

  :global(stream-recording.is-floating) .chapter-now-step {
    display: none;
  }

  :global(stream-recording.is-floating) .chapter-now-current .chapter-now-title {
    font-size: 0.95rem;
  }

  .chapter-now-item {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.1rem;
    margin: 0;
    padding: 0.5rem var(--chapter-inset);
    background: #fff;
  }

  .chapter-now-current {
    grid-area: now;
  }

  .chapter-now-step[data-step="-1"] {
    grid-area: previous;
  }

  .chapter-now-step[data-step="1"] {
    grid-area: next;
  }

  .chapter-now-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .source-link {
    display: inline-flex;
    flex: none;
    margin: -0.4rem -0.4rem -0.4rem 0;
    padding: 0.4rem;
    border-radius: 6px;
    font-size: 0.85rem;
  }

  .source-link :global(svg) {
    width: 1em;
    height: 1em;
  }

  .source-link:focus-visible {
    outline: 2px solid var(--recording-focus-color);
    outline-offset: -2px;
  }

  .chapter-now-label {
    color: #555;
    font-size: 0.85rem;
  }

  .chapter-now-current .chapter-now-label {
    color: #333;
    font-weight: 700;
  }

  .chapter-now-current .chapter-now-title {
    color: #211432;
    font-size: 1.1rem;
    font-weight: 700;
  }

  .chapter-now-step {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    gap: 0.5rem;
    padding-block: 0.35rem;
    border: 0;
    border-radius: 0;
    color: #555;
    font: inherit;
    text-align: start;
    cursor: pointer;
  }

  .chapter-now-step .chapter-now-label {
    flex: none;
  }

  .chapter-now-step .chapter-now-title {
    min-width: 0;
    overflow: hidden;
    font-size: 0.9rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @container player-card (max-width: 34rem) {
    .chapter-now-step {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }
  }

  .chapter-now-step .chapter-now-title {
    color: #211432;
  }

  .chapter-now-arrow {
    color: #211432;
    font-weight: 700;
  }

  .chapter-now-step:disabled {
    background: #f4f4f4;
    color: #aaa;
    cursor: default;
  }

  .chapter-now-step:disabled :is(.chapter-now-label, .chapter-now-title, .chapter-now-arrow) {
    color: #aaa;
  }

  @media (hover: hover) {
    .chapter-now-step:enabled:hover {
      background: #f5f5f5;
    }

    .chapter-now-step:enabled:hover .chapter-now-title {
      text-decoration: underline;
    }
  }

  .chapter-now-step:focus-visible {
    outline: 2px solid var(--recording-focus-color);
    outline-offset: 2px;
  }
</style>

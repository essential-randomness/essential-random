---
import type { CollectionEntry } from "astro:content";
import { formatTimestamp } from "./timestamp.ts";

interface Props {
  recordingId: string;
  groups: CollectionEntry<"streamRecordings">["data"]["groups"];
  screenshots: { time: number; src: string }[];
}

const { recordingId, groups, screenshots } = Astro.props;
const headingId = `${recordingId}-transcript-heading`;

const codeParts = (text: string) =>
  text.match(/^(["'(\[]*)(.*?)([.,?!:;"')\]]*)$/s)?.slice(1) ?? ["", text, ""];

const paragraphStarts = groups.flatMap((group) =>
  group.paragraphs.map((paragraph) => paragraph.start),
);
const screenshotsAt = Map.groupBy(
  screenshots,
  ({ time }) => paragraphStarts.findLast((start) => start <= time) ?? paragraphStarts[0],
);
---

<recording-transcript>
  <section class="transcript" aria-labelledby={headingId}>
    <div class="transcript-header">
      <div class="transcript-title">
        <h2 id={headingId}>Transcript</h2>
        <slot name="title-actions" />
      </div>
      <slot name="actions" />
    </div>
    <div class="transcript-viewport">
      <div
        class="transcript-scroll"
        role="region"
        aria-label="Scrollable interactive transcript"
        tabindex="0"
      >
        {groups.map((group) => (
          <div class="transcript-chapter">
            {group.title !== undefined && (
              <h3 class="transcript-chapter-heading">{group.title}</h3>
            )}
            {group.paragraphs.map((paragraph) => (
              <>
              {screenshotsAt.get(paragraph.start)?.map(({ time, src }) => (
                <button
                  class="transcript-screenshot"
                  type="button"
                  aria-label={`Screenshot from ${formatTimestamp(time)}`}
                  aria-pressed="false"
                >
                  <img
                    src={src}
                    alt=""
                    width="1269"
                    height="713"
                    loading="lazy"
                    decoding="async"
                  />
                </button>
              ))}
              <p class="transcript-line">
                <button
                  class="transcript-timestamp"
                  type="button"
                  data-seek-time={paragraph.start}
                  aria-label={`Jump to ${formatTimestamp(paragraph.start)}`}
                >
                  {formatTimestamp(paragraph.start)}
                </button>
                {paragraph.sentences.map((sentence) => (
                  <>
                    <span
                      class="transcript-sentence"
                      data-sentence={sentence.index}
                    >{sentence.words.map((word, index) => (
                      <>{index > 0 && " "}<span
                          class="transcript-word"
                          data-word-start={word.start}
                          data-word-end={word.end}
                        >{word.code
                          ? (() => {
                              const [before, core, after] = codeParts(word.text);
                              return <>{before}<code>{core}</code>{after}</>;
                            })()
                          : word.text}</span></>
                    ))}</span>{" "}
                  </>
                ))}
              </p>
              </>
            ))}
          </div>
        ))}
      </div>
      <button class="transcript-resume" type="button" hidden>
        Back to current
      </button>
    </div>
  </section>
</recording-transcript>

<script>
  import {
    ReadingModeEvent,
    RecordingElement,
    SeekEvent,
    TimeEvent,
  } from "./events.ts";
  import { Transcript } from "./transcript.ts";

  class RecordingTranscript extends RecordingElement {
    connect(signal: AbortSignal) {
      const section = this.querySelector<HTMLElement>(".transcript");
      const scroller = this.querySelector<HTMLElement>(".transcript-scroll");
      const resumeButton =
        this.querySelector<HTMLButtonElement>(".transcript-resume");
      if (!section || !scroller || !resumeButton) {
        return;
      }

      const transcript = new Transcript({
        section,
        scroller,
        resumeButton,
        signal,
      });
      this.listen({
        event: TimeEvent,
        handler: ({ time }) => transcript.showTime(time),
      });
      this.listen({ event: SeekEvent, handler: () => transcript.seeked() });

      const screenshots = scroller.querySelectorAll<HTMLElement>(
        ".transcript-screenshot",
      );
      let readingMode = false;
      const setScreenshotsExpanded = (expanded: boolean) => {
        for (const screenshot of screenshots) {
          screenshot.ariaPressed = String(expanded);
        }
      };

      this.listen({
        event: ReadingModeEvent,
        handler: ({ enabled }) => {
          readingMode = enabled;
          setScreenshotsExpanded(enabled);
          transcript.setReadingMode(enabled);
        },
      });

      scroller.addEventListener(
        "click",
        (event) => {
          if (!(event.target instanceof Element)) {
            return;
          }

          const screenshot = event.target.closest<HTMLElement>(
            ".transcript-screenshot",
          );
          if (screenshot) {
            const top = screenshot.getBoundingClientRect().top;
            setScreenshotsExpanded(screenshot.ariaPressed !== "true");
            const moved = screenshot.getBoundingClientRect().top - top;
            if (readingMode) {
              window.scrollBy(0, moved);
            } else {
              scroller.scrollTop += moved;
            }
            return;
          }

          const timestamp =
            event.target.closest<HTMLElement>("[data-seek-time]");
          const word = event.target.closest<HTMLElement>(".transcript-word");
          const time = timestamp
            ? timestamp.dataset.seekTime
            : word?.dataset.wordStart;

          if (time !== undefined) {

            this.send(new SeekEvent(Number(time)));

          }
        },
        { signal },
      );
    }
  }

  customElements.define("recording-transcript", RecordingTranscript);
</script>

<style>
  recording-transcript {
    display: block;
    min-width: 0;
  }

  .transcript {
    border: var(--recording-card-border);
    border-radius: var(--recording-card-radius);
    box-shadow: var(--box-shadow);
  }

  .transcript-header {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin: 0;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid #ddd;
  }

  .transcript-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1rem;
  }

  .transcript h2 {
    margin: 0;
    font-size: 1.35rem;
  }

  .transcript-scroll {
    --transcript-padding: 0.75rem;
    max-height: max(var(--transcript-max-height, min(28rem, 70vh)), 16rem);
    overflow: auto;
    padding: 0 var(--transcript-padding) var(--transcript-padding);
    overflow-wrap: anywhere;
  }

  .transcript-viewport {
    position: relative;
    overflow: hidden;
    border-radius: 0 0 calc(var(--recording-card-radius) - 2px)
      calc(var(--recording-card-radius) - 2px);
  }

  :global(stream-recording.is-reading) .transcript-viewport {
    overflow: visible;
  }

  :global(stream-recording.is-reading) .transcript-scroll {
    max-height: none;
    overflow: visible;
    padding-block-end: 40vh;
  }

  .transcript-resume {
    position: absolute;
    inset-inline-end: 0.75rem;
    inset-block-end: 0.75rem;
    min-height: 2.75rem;
    padding: 0.35rem 0.85rem;
    border: 2px solid #000;
    border-radius: 999px;
    background: #efe5ff;
    color: #211432;
    font: inherit;
    font-size: 0.9rem;
    box-shadow: var(--box-shadow);
    cursor: pointer;
  }

  .transcript-resume[hidden] {
    display: none;
  }

  :global(stream-recording.is-reading) .transcript-resume {
    position: fixed;
    z-index: 10;
    inset-inline: 1rem auto;
    inset-block-end: 1rem;
    max-width: calc(100vw - var(--recording-mini-player-width) - 4rem);
    box-sizing: border-box;
    white-space: normal;
  }

  .transcript-chapter + .transcript-chapter {
    margin-top: 1.25rem;
    padding-top: 0.75rem;
    border-top: 1px solid #ccc;
  }

  .transcript-chapter-heading {
    position: sticky;
    top: 0;
    z-index: 1;
    margin: 0 calc(-1 * var(--transcript-padding)) 0.5rem;
    padding: 0.35rem var(--transcript-padding);
    border-bottom: 1px solid #ddd;
    background: #fff;
    font-size: 1.05rem;
  }

  .transcript-screenshot {
    display: block;
    width: 100%;
    max-width: 20rem;
    margin: 0.25rem auto 0.8rem;
    padding: 0;
    border: 1px solid #777;
    border-radius: 6px;
    overflow: hidden;
    background: transparent;
    cursor: zoom-in;
  }

  .transcript-screenshot[aria-pressed="true"] {
    max-width: none;
    cursor: zoom-out;
  }

  .transcript-screenshot img {
    display: block;
    width: 100%;
    height: auto;
    padding: 0;
  }

  .transcript-line {
    margin: 0 0 0.8rem;
    line-height: 1.7;
  }

  .transcript-line:last-child {
    margin-bottom: 0;
  }

  .transcript-timestamp {
    position: relative;
    margin-inline-end: 0.35rem;
    padding: 0 0.3rem;
    border: 0;
    border-radius: 5px;
    background: transparent;
    color: var(--recording-accent);
    font: inherit;
    font-variant-numeric: tabular-nums;
    text-decoration: underline;
    cursor: pointer;
  }

  .transcript-timestamp::before {
    content: "";
    position: absolute;
    inset: -0.6rem -0.2rem;
  }

  .transcript-word {
    border-radius: 0.15rem;
    color: #555;
    cursor: pointer;
  }

  .transcript-word code {
    padding: 0 0.2em;
    border-radius: 0.2rem;
    background: #f1eef5;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.9em;
  }

  .transcript-sentence.is-current {
    border-radius: 0.15rem;
    background: #f7f2ff;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .transcript-sentence.is-current .transcript-word {
    color: #2b2238;
  }

  .transcript-word.is-active {
    color: #211432;
    background: #efe5ff;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  :is(.transcript-scroll, .transcript-timestamp, .transcript-screenshot, .transcript-resume):focus-visible {
    outline: 2px solid var(--recording-focus-color);
    outline-offset: 2px;
  }

  .transcript-scroll:focus-visible {
    outline-offset: -2px;
  }

  @media (hover: hover) {
    .transcript-timestamp:hover,
    .transcript-word:hover {
      background: #f2eaff;
    }
  }

  @media (max-width: 40rem) {
    .transcript {
      padding: 0.5rem;
    }

    .transcript-scroll {
      --transcript-padding: 0.5rem;
    }
  }
</style>

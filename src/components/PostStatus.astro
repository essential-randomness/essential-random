---
interface Props {
  status: "rough-draft" | "pre-beta" | undefined;
}

const { status } = Astro.props;
---

{
  status && (
    <aside
      class:list={["post-status", status, "callout", `callout-${status}`]}
      role="note"
      aria-labelledby={`post-status-${status}-title`}
      data-callout={status}
    >
      {status == "rough-draft" && (
        <p id={`post-status-${status}-title`} class="callout-title">
          Warning: Roughness Ahead~
        </p>
      )}
      {status == "pre-beta" && (
        <p id={`post-status-${status}-title`} class="callout-title">
          Warning: Almost There but Not Quite
        </p>
      )}
      {status == "rough-draft" && (
        <div class="callout-content">
          <p>
            <span>
              The post you're about to read is marked as a
              <strong>rough draft</strong>!
            </span>
            Rough drafts might provide unclear (or wrong) information, be hard
            to read, or otherwise all over the place.
            <em>Trust them at your own risk!</em>
          </p>
          <p class="contact-me">
            Want to learn more or help correct something? Hit me up on socials!
          </p>
        </div>
      )}
      {status == "pre-beta" && (
        <div class="callout-content">
          <p>
            <span>
              The post you're about to read is marked as{" "}
              <strong>pre-beta</strong>!
            </span>
            While the content <em>should</em> be overall accurate and
            understandable, it was not reviewed for flow, imprecisions, typos,
            or accidentally-abandoned sentences.
          </p>
          <p class="contact-me">
            Venturing through? Let me know your thoughts!
          </p>
        </div>
      )}
    </aside>
  )
}

<script>
  import { annotate } from "rough-notation";
  import { redrawOnLayoutChange } from "../utils/redraw-on-layout-change";

  const container = document.querySelector<HTMLElement>(".post-status");
  if (container) {
    const isRoughDraft = container.classList.contains("rough-draft");
    const title = container.querySelector<HTMLElement>("span");

    const annotations = [
      annotate(container, {
        type: "box",
        animate: false,
        padding: -4,
      }),
    ];

    if (title) {
      annotations.push(
        annotate(title, {
          type: "highlight",
          animate: false,
          color: isRoughDraft ? "lightgray" : "lightskyblue",
          padding: -4,
          multiline: true,
        })
      );
    }

    redrawOnLayoutChange(title ? [container, title] : [container], () => {
      for (const annotation of annotations) {
        annotation.show();
      }
    });
  }
</script>

<style>
  .rough-draft,
  .pre-beta {
    padding: 20px 40px;
    box-shadow: 7px 10px 0 0px black;
    border-radius: 3px;
    width: 80%;
    margin: 35px auto;
    /* background-color: papayawhip; */
    span {
      font-weight: bold;
      margin-right: 4px;
    }
    .contact-me {
      font-size: small;
    }
  }
</style>
